# Default strictfmt golden-fixture style with runtime macro fixtures.
---
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4

IncludeCategories:
  - Regex: '^<(winsock2|ws2tcpip)\.h>$'
    Priority: 1
  - Regex: '^<windows\.h>$'
    Priority: 2
  - Regex: '^<.*>$'
    Priority: 3
  - Regex: '^"vendor/.*"$'
    Priority: 4
  - Regex: '^".*"$'
    Priority: 5
MainIncludeChar: Quote
IncludeIsMainRegex: '(Test)?$'

MacroCategories:
  ExpressionContinuationMacros:
    - FORMAT_TOKEN_COMPARE
    - FORMAT_CONTINUATION_*
  MethodDeclarationMacros:
    - FORMAT_METHOD_SIGNATURE
    - FORMAT_TYPE_METHOD
  StatementArgumentMacros:
    - FORMAT_STATEMENT_DECLARATIONS
  PreprocessorArgumentMacros:
    - FORMAT_TOKEN_*
  DeclarationModifierMacros:
    - FORMAT_ATTRIBUTE_*
    - FORMAT_DECLARATOR_MODIFIER
    - FORMAT_DECLARATOR_ATTRIBUTE
    - FORMAT_PARAMETER_SUFFIX
    - FORMAT_PARAMETER_SUFFIX_CALL
    - WINAPI
  StatementPrefixMacros:
    - FORMAT_STATEMENT_PREFIX_*
  ItemMacros:
    - DECLARE_ATTRIBUTES
    - FORMAT_TOKEN_ITEM
    - FORMAT_TOKEN_STATEMENT
    - FORMAT_TOKEN_WRAPPER
    - FORMAT_SEMILESS_*
    - FORMAT_FIXTURE_CREATE_METRIC
    - FORMAT_FIXTURE_REGISTER_TYPE
    - FORMAT_ITEM_*

StreamShift:
  ConfigurationMethods:
    - std::boolalpha
    - std::noboolalpha
    - std::showbase
    - std::noshowbase
    - std::showpoint
    - std::noshowpoint
    - std::showpos
    - std::noshowpos
    - std::skipws
    - std::noskipws
    - std::uppercase
    - std::nouppercase
    - std::unitbuf
    - std::nounitbuf
    - std::internal
    - std::left
    - std::right
    - std::dec
    - std::hex
    - std::oct
    - std::fixed
    - std::scientific
    - std::hexfloat
    - std::defaultfloat
    - std::setbase
    - std::setfill
    - std::setprecision
    - std::setw
    - std::resetiosflags
    - std::setiosflags
    - std::emit_on_flush
    - std::noemit_on_flush
