# Default strictfmt golden-fixture style with runtime macro fixtures.
---
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4

IncludeCategories:
  - Regex: '^<(winsock2|ws2tcpip)\.h>$'
    Priority: 1
  - Regex: '^<windows\.h>$'
    Priority: 2
  - Regex: '^<.*>$'
    Priority: 3
  - Regex: '^"vendor/.*"$'
    Priority: 4
  - Regex: '^".*"$'
    Priority: 5
MainIncludeChar: Quote
IncludeIsMainRegex: '(Test)?$'

MacroCategories:
  DeclarationPrefixMacros:
    - FORMAT_ATTRIBUTE_*
    - FORMAT_DECLARATOR_MODIFIER
    - FORMAT_DECLARATOR_ATTRIBUTE
  StatementPrefixMacros:
    - FORMAT_STATEMENT_PREFIX_*
  RawMacroDefinitions:
    - FORMAT_STATEMENT_PREFIX_*
    - FORMAT_FIXTURE_STATEMENT_ARGUMENT
    - FORMAT_FIXTURE_STRINGIZE
    - FORMAT_FIXTURE_TOKEN_PASTE
  BareIdentifierMacros:
    - FORMAT_DECLARATOR_MODIFIER
    - WINAPI
  CallSyntaxMacros:
    - FORMAT_ENUM_ATTR
    - FORMAT_ANON_*
    - FORMAT_TYPE_*
    - FORMAT_PASTED_DECL_*
    - ENUM_STRING_DECLARE
    - FORMAT_FIXTURE_STATEMENT_ARGUMENT
    - FORMAT_FIXTURE_DECLARE_OPTION
  SemicolonlessCallMacros:
    - FORMAT_SEMILESS_*
    - FORMAT_FIXTURE_CREATE_METRIC
    - FORMAT_FIXTURE_REGISTER_TYPE

StreamShift:
  ConfigurationMethods:
    - std::boolalpha
    - std::noboolalpha
    - std::showbase
    - std::noshowbase
    - std::showpoint
    - std::noshowpoint
    - std::showpos
    - std::noshowpos
    - std::skipws
    - std::noskipws
    - std::uppercase
    - std::nouppercase
    - std::unitbuf
    - std::nounitbuf
    - std::internal
    - std::left
    - std::right
    - std::dec
    - std::hex
    - std::oct
    - std::fixed
    - std::scientific
    - std::hexfloat
    - std::defaultfloat
    - std::setbase
    - std::setfill
    - std::setprecision
    - std::setw
    - std::resetiosflags
    - std::setiosflags
    - std::emit_on_flush
    - std::noemit_on_flush
