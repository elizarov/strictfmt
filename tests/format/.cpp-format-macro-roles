# Formatting roles for the corpus also parsed without macro configuration.
ColumnLimit: 80
MacroCategories:
  MethodDeclarationMacros:
    - DECLARE_METHOD
  PreprocessorArgumentMacros:
    - GENERATE_FIELDS
    - TOKENS
  BareIdentifierMacros:
    - BEGIN_NAMESPACE
    - END_NAMESPACE
    - GENERATED_MEMBERS
    - ANNOTATION
    - ENUM_PREFIX
    - TYPE_ITEMS
  DeclarationPrefixMacros:
    - API_EXPORT
  StatementArgumentMacros:
    - CHECK_STATEMENT
    - DEFINE_ACTION
  SemicolonlessCallMacros:
    - GENERATE_FIELDS
    - DEFINE_ACTION
    - STEP
  TypeSpecifierMacros:
    - TYPE_OF
