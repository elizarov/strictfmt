# Formatting roles for the corpus also parsed without macro configuration.
ColumnLimit: 80
MacroCategories:
  ExpressionContinuationMacros:
    - APPEND_OPTIONS
  MethodDeclarationMacros:
    - DECLARE_METHOD
  PreprocessorArgumentMacros:
    - PP_EXPANSION
    - GENERATE_FIELDS
    - TOKENS
  DeclarationModifierMacros:
    - API_EXPORT
    - ANNOTATION
  StatementArgumentMacros:
    - CHECK_STATEMENT
    - DEFINE_ACTION
  ItemMacros:
    - GENERATE_FIELDS
    - DEFINE_ACTION
    - STEP
    - BEGIN_NAMESPACE
    - END_NAMESPACE
    - GENERATED_MEMBERS
    - TYPE_ITEMS
    - ENUM_ITEMS
  TypeSpecifierMacros:
    - REMOVE_CV_REF
    - TYPE_OF
