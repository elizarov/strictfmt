# Userver golden-fixture style.
# Keep non-macro style fields in sync with the adjacent userver checkout.
# MacroCategories below are the fixture-specific runtime scanner inputs.
# No IncludeCategories entry: mirrors userver .clang-format IncludeBlocks: Preserve behavior.
---
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4

MainIncludeChar: Quote
IncludeIsMainRegex: '(Test)?$'

MacroCategories:
  RawMacroDefinitions:
    - FORMAT_USERVER_COMPLEX_OPTION
    - FORMAT_USERVER_DO_WHILE
    - FORMAT_USERVER_EXPECT_TRY
    - FORMAT_USERVER_HASH_JOIN
    - FORMAT_USERVER_PROTECTED_ATTR
    - FORMAT_USERVER_CONST
    - IMPL_UTEST_FORMAT_USERVER
    - LOG_FORMAT_USERVER_LIMITED
    - CURL_FORMAT_USERVER_NAMESPACE
    - USERVER_IMPL_FORCE_INLINE
    - USERVER_IMPL_NODEBUG*
  BareIdentifierMacros:
    - __rseq_percpu
    - FORMAT_USERVER_ATOMIC_INIT
    - BENCHMARK_THREAD_ARGS*
    - FORMAT_USERVER_LIFETIME_BOUND*
    - USERVER_IMPL_NODEBUG
    - USERVER_IMPL_FORCE_INLINE
    - ATTRIBUTE_NO_SANITIZE_UNDEFINED
    - FORMAT_USERVER_ALWAYS_INLINE_SIMD
    - FORMAT_USERVER_NODEBUG_FUNC
    - FORMAT_USERVER_PROTECTED_ATTR
    - CURL_FORMAT_USERVER_NAMESPACE
    - RAPIDJSON_NOEXCEPT
    - USERVER_IMPL_LIBC_INCLUDE_FIXES_THROW*
  DeclarationPrefixMacros:
    - FORMAT_API_
  CallSyntaxMacros:
    - FORMAT_FIXTURE_DECLARE_OPTION
    - UTEST_MT
    - UTEST_DEATH
    - BENCHMARK_CAPTURE
    - BENCHMARK_DEFINE_F
    - BENCHMARK_DEFINE_TEMPLATE_F
    - BENCHMARK_INSTANTIATE_TEMPLATE_F
    - BENCHMARK_TEMPLATE
    - MOCK_METHOD
    - MATCHER_P
    - TEST_COMMAND
    - GTEST_REPEATER_METHOD_
    - GTEST_REVERSE_REPEATER_METHOD_
    - INSTANTIATE_UTEST_SUITE_P
    - TYPED_UTEST_MT
    - TYPED_UTEST_P_MT
    - TYPED_UTEST_SUITE_P
  SemicolonlessCallMacros:
    - GTEST_DISABLE_DEPRECATED_*
    - GTEST_DISABLE_MSC_WARNINGS_*
    - RET_NAME
  StatementArgumentMacros:
    - UEXPECT_THROW
    - UEXPECT_NO_THROW
    - UEXPECT_THROW_MSG
    - UASSERT_NO_THROW
    - EXPECT_FATAL_FAILURE
    - EXPECT_NONFATAL_FAILURE
    - EXPECT_THROW
    - EXPECT_NO_THROW
    - EXPECT_ANY_THROW
    - ASSERT_THROW
    - ASSERT_NO_THROW
    - ASSERT_ANY_THROW

StreamShift:
  ConfigurationMethods:
    - std::boolalpha
    - std::noboolalpha
    - std::showbase
    - std::noshowbase
    - std::showpoint
    - std::noshowpoint
    - std::showpos
    - std::noshowpos
    - std::skipws
    - std::noskipws
    - std::uppercase
    - std::nouppercase
    - std::unitbuf
    - std::nounitbuf
    - std::internal
    - std::left
    - std::right
    - std::dec
    - std::hex
    - std::oct
    - std::fixed
    - std::scientific
    - std::hexfloat
    - std::defaultfloat
    - std::setbase
    - std::setfill
    - std::setprecision
    - std::setw
    - std::resetiosflags
    - std::setiosflags
    - std::emit_on_flush
    - std::noemit_on_flush
